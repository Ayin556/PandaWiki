# ====================
# 服务器配置
# ====================
HTTP_PORT=8000
LOG_LEVEL=INFO
ENV=development

# ====================
# PostgreSQL
# ====================
PG_HOST=localhost
PG_PORT=5432
PG_USER=panda-wiki
PG_PASSWORD=panda-wiki
PG_DB=panda-wiki
PG_DSN=postgresql+asyncpg://panda-wiki:panda-wiki@localhost:5432/panda-wiki

# ====================
# Redis
# ====================
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ====================
# JWT
# ====================
JWT_SECRET=your-secret-key-change-in-production

# ====================
# 管理员
# ====================
ADMIN_PASSWORD=admin123

# ====================
# NATS 消息队列
# ====================
MQ_NATS_SERVER=nats://localhost:4222
NATS_PASSWORD=

# ====================
# RAG / LangChain
# ====================
RAG_BASE_URL=http://localhost:8001
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# ====================
# MinIO / S3
# ====================
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=static-file
S3_USE_SSL=false

# ====================
# Sentry (可选)
# ====================
SENTRY_ENABLED=false
SENTRY_DSN=

# ====================
# Caddy (可选)
# ====================
CADDY_API=
CADDY_ENABLED=false

# ====================
# 子网前缀
# ====================
SUBNET_PREFIX=169.254.15
